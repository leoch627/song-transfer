SPOTIFY_CLIENT_ID=
# Register this exact URL in the Spotify developer dashboard.
APP_URL=http://127.0.0.1:3002
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Your OpenAI-compatible relay. Include /v1 if required by your relay.
AI_BASE_URL=https://api.loe.cx/v1
AI_API_KEY=
AI_MODEL=gpt-6-luna
# Concurrent AI reviews per browser and relay calls per server process (1–5).
AI_REVIEW_CONCURRENCY=3
# chat_completions or responses; the relay must support JSON Schema output.
AI_API_STYLE=chat_completions
# Requires Responses API web_search support on the same relay.
AI_WEB_SEARCH=0
